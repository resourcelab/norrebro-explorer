prototypes/*/world/
prototypes/*/dist/*
!prototypes/*/dist/assistens-kirkegaard-paper-walk.html

# local review captures (regenerate with npm run capture)
**/docs/frames/

# Python
__pycache__/
*.pyc
.venv/

# editors and OS
.DS_Store
.vscode/
.idea/
*.swp

# environment files
.env
.env.*
